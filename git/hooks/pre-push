#!/bin/sh

# 共用 hook：core.hooksPath 會完全取代 .git/hooks，
# 這裡先轉發回 repo 自身的 hook，再執行共用邏輯。

local_hook="$(git rev-parse --path-format=absolute --git-common-dir)/hooks/pre-push"

if [ -x "$local_hook" ]; then
    "$local_hook" "$@" || exit $?
fi

# 專案有定義 make test 才執行；未定義者直接放行，不阻擋 push
if [ -f Makefile ] && make -n test >/dev/null 2>&1; then
    make test || exit 1
fi

exit 0
